@startuml
skinparam rectangle {
    BackgroundColor<<Actores>> #E3F2FD
    BackgroundColor<<Cloud>> #E8F5E9
    BackgroundColor<<LocalOSS>> #FFF3E0
    BackgroundColor<<Planificado>> #F5F5F5
    BorderStyle dashed
}

rectangle "1. Participantes del Proceso" as Actores <<Actores>> {
    card Cliente [
        **Cliente / Interesado**
        (Redes Sociales / WhatsApp)
    ]
    card Encargada [
        **Encargada de Atencion**
        (Peluditos Pet Chile)
    ]
}

rectangle "2. Entorno Cloud IPLACEX (Prototipo Funcional)" as Cloud <<Cloud>> {
    artifact FE [
        **Flowable Enterprise Cloud**
        Proceso TO-BE y Formularios
    ]
}

rectangle "3. Entorno Local de Integracion (Apache Tomcat + Java)" as LocalOSS <<LocalOSS>> {
    component FUI [
        **Flowable UI / Engine OSS**
        (Tomcat :8080)
    ]
    interface FAPI [
        **Flowable External Job REST API**
        (/external-job-api)
    ]
    database H2 [
        **Base de Datos H2**
        (flowable-db)
    ]
    node Worker [
        **External Worker Java**
        (external-worker-peluditos)
    ]
    component RestSvc [
        **Servicio REST Java Javalin**
        (GET /api/seguimiento)
    ]
}

rectangle "4. Componentes Planificados (Entrega 2)" as Planificado <<Planificado>> {
    database DBClientes [
        **BD Clientes y Mascotas**
        (Persistencia de Leads)
    ]
    component Notif [
        **Servicio de Campanas y Cumpleanos**
        (Recompra)
    ]
}

' Relaciones y flujos
Cliente --> Encargada : "1. Realiza consulta"
Encargada --> FE : "2a. Formularios TO-BE"
Encargada --> FUI : "2b. Inicia proceso y tareas"
FUI --> H2
FUI --> FAPI
Worker --> FAPI : "3. Adquiere y completa job"
Worker --> RestSvc : "4. HTTP GET /api/seguimiento"
RestSvc ..> Worker : "5. Respuesta JSON OK"
RestSvc ..> DBClientes : "[Planificado]"
FUI ..> Notif : "[Planificado]"

@enduml
