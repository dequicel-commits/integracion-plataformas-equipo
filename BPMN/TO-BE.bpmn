  <message id="MensajeActivarCampanasEntrega3" name="Activar campañas y fechas especiales - Entrega 3"></message>
  <process id="peluditosPetChileTOBE12" name="Peluditos Pet Chile - TO-BE Entrega 4" isExecutable="true">
    <documentation>Este modelo representa los dos recorridos integrados de Peluditos Pet Chile: 1) Registro del potencial cliente y seguimiento comercial (con los External Workers guardar-cliente-peluditos y actualizar-seguimiento-peluditos), y 2) Gestion de campanas, cumpleanos de mascotas y fechas especiales filtrando por fecha/mes y tipo/tamano de mascota (con los External Workers seleccionar-clientes-campana y registrar-seguimiento-campana, incluyendo la compuerta exclusiva para validar si existen clientes elegibles).</documentation>
    <extensionElements>
      <flowable:candidates-type><![CDATA[all]]></flowable:candidates-type>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
      <design:creationdate><![CDATA[2026-11-20T19:50:23.275Z]]></design:creationdate>
      <design:modificationdate><![CDATA[2026-11-28T00:05:00.000Z]]></design:modificationdate>
    </extensionElements>
    <userTask id="FormTask_3" name="Atender y responder consulta del cliente" flowable:assignee="${initiator}" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
